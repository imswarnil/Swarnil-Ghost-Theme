{{!--
    Post metadata: authors, date, reading time.

    Every part degrades. A post with one author, no reading time and no tags
    still produces a valid, balanced line rather than stray separators — the
    separators are drawn by CSS on adjacent items, so a missing item takes its
    separator with it.
--}}
<div class="ghost-slate {{class}}">
    {{#if featured}}
        <span class="ghost-slate__item ghost-slate__item--accent">Featured</span>
    {{/if}}

    {{#if primary_author}}
        <span class="ghost-slate__item">
            <a href="{{primary_author.url}}">{{primary_author.name}}</a>
        </span>
    {{/if}}

    <span class="ghost-slate__item">
        <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time>
    </span>

    {{#if @custom.show_reading_time}}
        <span class="ghost-slate__item">{{reading_time}}</span>
    {{/if}}

    {{#unless access}}
        <span class="ghost-slate__item ghost-slate__item--accent">Members only</span>
    {{/unless}}
</div>
