{{!--
    The post inside the lead slot.

    Split out from lead.hbs only because both branches of the homepage_lead
    setting render the same thing from a different query, and duplicating it
    would be two places to fix later.
--}}
<article class="ghost-lead__post">
    {{#if feature_image}}
        <div class="ghost-lead__media">
            {{> "frame" src=feature_image alt=title eager=true}}
        </div>
    {{/if}}

    <div class="ghost-lead__body">
        {{> "byline"}}

        <h2 class="ghost-lead__title">
            <a class="ghost-lead__link" href="{{url}}">{{title}}</a>
        </h2>

        {{#if excerpt}}
            <p class="ghost-lead__excerpt">{{excerpt words="32"}}</p>
        {{/if}}

        {{> "tags" class="ghost-card__tags"}}
    </div>
</article>
