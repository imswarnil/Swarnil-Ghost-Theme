{{!--
    Site header.

    One markup shape for all three header styles; the style setting only changes
    which modifier class is applied. "Over Media" additionally requires a feature
    image to sit on, so it falls back to "Rule" on any page without one —
    a transparent header over a white background would be invisible.
--}}
<header class="ghost-header ghost-header--{{#match @custom.header_style "Plate"}}plate{{else match @custom.header_style "Over Media"}}{{#if feature_image}}over{{else}}rule{{/if}}{{else}}rule{{/match}}" data-header>
    <div class="ghost-container ghost-header__inner">

        {{!-- Brand: the uploaded logo if there is one, the site title if not. --}}
        <a class="ghost-brand" href="{{@site.url}}">
            {{#if @site.logo}}
                <img class="ghost-brand__logo" src="{{img_url @site.logo size="s"}}" alt="{{@site.title}}" loading="eager" width="200" height="28">
            {{else}}
                <span class="ghost-brand__dot"></span>
                <span class="ghost-brand__title">{{@site.title}}</span>
            {{/if}}
        </a>

        <div class="ghost-header__nav">
            {{> "navigation" variant="header" type="primary" label="Main navigation"}}
        </div>

        <div class="ghost-header__actions">

            {{!-- Ghost's search is opened by any element carrying data-ghost-search.
                 It is injected by {{ghost_foot}}, so there is nothing to build. --}}
            <button class="ghost-button ghost-button--icon" data-ghost-search aria-label="Search this site">
                {{> "icon" name="search"}}
            </button>

            {{#if @custom.show_color_scheme_toggle}}
                <button class="ghost-button ghost-button--icon ghost-scheme" data-scheme-toggle aria-label="Change colour scheme">
                    <span class="ghost-scheme__icon ghost-scheme__icon--system">{{> "icon" name="system"}}</span>
                    <span class="ghost-scheme__icon ghost-scheme__icon--light">{{> "icon" name="sun"}}</span>
                    <span class="ghost-scheme__icon ghost-scheme__icon--dark">{{> "icon" name="moon"}}</span>
                </button>
            {{/if}}

            {{#if @site.members_enabled}}
                {{#unless @member}}
                    <a class="ghost-button ghost-button--outline" href="#/portal/signup">Subscribe</a>
                {{else}}
                    <a class="ghost-button ghost-button--quiet" href="#/portal/account">Account</a>
                {{/unless}}
            {{/if}}

            <button class="ghost-button ghost-button--icon ghost-nav-toggle" data-drawer-open aria-expanded="false" aria-controls="ghost-drawer" aria-label="Open navigation">
                {{> "icon" name="menu"}}
            </button>

        </div>
    </div>
</header>
