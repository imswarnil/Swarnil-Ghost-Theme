# Dependencies
node_modules/

# The design system, cloned at the exact commit in package.json →
# designSystem.ref by `npm run ds:sync`. Pinned rather than tracked: it is a
# dependency, and the ref in package.json is the thing under version control.
.ds/

# The packaged theme, rebuilt by `npm run zip`
*.zip

# Credentials. The Ghost Admin API key is a site-wide write credential — it can
# publish, edit and delete anything. It lives here and in GitHub Secrets, and
# nowhere else. .env.example documents the shape without the values.
.env
.env.*
!.env.example

# OS noise
.DS_Store
Thumbs.db

# Local working notes. Never ships — not to GitHub, not into the zip.
abstract/

# Deliberately NOT ignored:
#   assets/built/      Ghost serves it and it ships to buyers, so it is
#                      committed alongside its source.
#   docs/**            generated by `npm run docs`, but it is what GitHub Pages
#                      publishes — the HTML, the search index, the section
#                      thumbnails and docs.pdf all have to be in the repository
#                      or the published site is missing them.
#                      docs/assets/docs.css and docs/assets/docs.js are hand
#                      authored; docs/src/*.md is the source of everything else.
#   docs/assets/preview-*.png
#                      captured from the local preview Ghost by
#                      `npm run docs:capture`; the public site cannot reach it.
