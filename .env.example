# Credentials for deploying this theme to a Ghost site.
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Where these come from — Ghost admin →
#   Settings → Advanced → Integrations → Add custom integration
#
# Name it something you will recognise later, e.g. "Theme deploy".

# The site's origin. No trailing path, no trailing slash.
API_URL=https://example.com

# The Admin API key, shown as "<id>:<secret>". Paste it whole, colon included.
#
# This is a write credential for the entire site. Treat it like a password:
# never commit it, never paste it into an issue, and revoke the integration in
# Ghost if it is ever exposed.
ADMIN_API_KEY=

# The Content API key. Read-only, and not needed to deploy a theme — it is here
# because tooling that reads posts (a preview build, a link checker) uses it.
CONTENT_API_KEY=
